#
# Normalise line endings so that a clone on Windows, macOS or Linux produces
# byte identical files. Knap's style checks compare bytes, so a CRLF checkout
# would otherwise fail the build on Windows only.

* text=auto eol=lf

*.mojo   text eol=lf
*.py     text eol=lf
*.md     text eol=lf
*.toml   text eol=lf
*.yml    text eol=lf
*.cff    text eol=lf
*.sh     text eol=lf
LICENSE  text eol=lf

# Test fixtures are compared byte for byte. Git must never touch them.
tests/fixtures/**      -text
tests/golden/**        -text
*.bin                  binary
*.tiktoken             binary

# Brand artwork. The vector files are text and are normalised like any other
# text file. The raster ones are not, and Git must not rewrite their bytes.
*.svg                  text eol=lf
*.png                  binary
*.jpg                  binary
*.ico                  binary
