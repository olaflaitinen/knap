# Environments. Mojo installs as an ordinary Python package, so the compiler
# itself lives under .venv and must never be committed.
.venv/
.pixi/
__pycache__/
*.pyc

# Mojo build and cache outputs.
.mojo_cache/
*.mojopkg
*.mojoc
build/
dist/
*.so
*.o
*.s

# Vocabulary files are fetched by scripts/fetch_vocabs.py, never committed,
# so that no licence question attaches to this repository. See
# tests/fixtures/vocabs/README.md.
tests/fixtures/vocabs/*.tiktoken
tests/fixtures/hf/*.json

# The large benchmark and parity corpus is fetched by scripts/fetch_corpus.py
# into bench/corpus/ and is never committed. The small hand written edge case
# files under tests/fixtures/corpus/ ARE committed: they are fixtures rather
# than corpus, and the tests depend on their exact bytes.
bench/corpus/

# Generated golden files are large; they are regenerated by the scripts in
# scripts/ and are not committed except where a test needs a small sample.
tests/golden/**/*.jsonl

# Local editor state.
.vscode/
.idea/
.DS_Store

# Temporary sandbox written by scripts/selftest_gates.py.
.gate_selftest/

# Exhaustive Unicode reference, written by scripts/gen_unicode_tables.py.
tests/golden/unicode_classes.txt
