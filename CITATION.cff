    orcid: "https://orcid.org/0009-0006-5184-0810"
    affiliation: >-
      School of Information and Communication Technology, Metropolia
      University of Applied Sciences
repository-code: "https://github.com/olaflaitinen/knap"
url: "https://github.com/olaflaitinen/knap"
license: EUPL-1.2
version: "1.0.0"
date-released: "2026-09-11"
# The concept DOI, which always resolves to the most recent version. Cite
# this one unless you need the exact version you used, in which case the
# 1.0.0 DOI is 10.5281/zenodo.22701441.
doi: "10.5281/zenodo.22701440"
keywords:
