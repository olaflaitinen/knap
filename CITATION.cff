    family-names: "Laitinen Imanov"
    email: "yunus.imanov@metropolia.fi"
    orcid: "https://orcid.org/0009-0006-5184-0810"
    affiliation: >-
      School of Information and Communication Technology, Metropolia
      University of Applied Sciences
license: EUPL-1.2
version: "0.1.0"
date-released: "2026-09-07"
keywords:
