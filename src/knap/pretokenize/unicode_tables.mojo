"""Unicode general category tables for the Knap pre-tokenizer.

Every code point carries one class. Letter is the union of the five
letter classes, which is why both patterns can be served from a
single table rather than from eight independent ones.

The tables are ASCII hex strings rather than list literals. That is
a compiler constraint, not a preference: a list literal of this size
did not finish compiling in ten minutes, while the same data as a
string literal compiled in under six seconds. See docs/UNICODE.md.

Lookup is O(1) for ASCII through a direct table, and a binary search
over sorted runs above that. The scanner reaches the binary search
only on non-ASCII input, which is the documented slow path.
"""


# -----------------------------------------------------------------------------
# Class constants
#
# One value per code point. Letter is classes 1 through 5, which
# lets is_letter be a range test rather than five comparisons.
# -----------------------------------------------------------------------------

comptime CLASS_OTHER: UInt8 = 0
"""Code point in no category the patterns care about."""

comptime CLASS_LU: UInt8 = 1
"""Uppercase letter, Unicode general category Lu."""

comptime CLASS_LL: UInt8 = 2
"""Lowercase letter, Unicode general category Ll."""

comptime CLASS_LT: UInt8 = 3
"""Titlecase letter, Unicode general category Lt."""

comptime CLASS_LM: UInt8 = 4
"""Modifier letter, Unicode general category Lm."""

comptime CLASS_LO: UInt8 = 5
"""Other letter, Unicode general category Lo."""

comptime CLASS_M: UInt8 = 6
"""Mark, any of the Unicode general categories Mn, Mc, and Me."""

comptime CLASS_N: UInt8 = 7
"""Number, any of the Unicode general categories Nd, Nl, and No."""

comptime UNICODE_VERSION: StaticString = "15.0.0"
"""Version of the Unicode Character Database these tables came from."""

comptime RUN_COUNT: Int = 2342
"""Number of sorted class runs in the tables below."""

comptime WHITESPACE_COUNT: Int = 25
"""Number of code points the patterns treat as whitespace."""


# -----------------------------------------------------------------------------
# Encoded tables
#
# Each run contributes six hex digits of start, six of end, and one
# of class, held in three parallel strings. The ASCII table is one
# hex digit per code point, indexed directly.
# -----------------------------------------------------------------------------

comptime RUN_STARTS: StaticString = ""
"""First code point of each run, six hex digits each."""

comptime RUN_ENDS: StaticString = ""
"""Last code point of each run, six hex digits each."""

comptime RUN_CLASSES: StaticString = ""
"""Class of each run, one hex digit each."""

comptime ASCII_CLASSES: StaticString = "00000000000000000000000000000000000000000000000077777777770000000111111111111111111111111110000002222222222222222222222222200000"
"""Class of each of the 128 ASCII code points, one hex digit each."""

comptime WHITESPACE_CODE_POINTS: StaticString = "00000900000a00000b00000c00000d0000200000850000a000168000200000200100200200200300200400200500200600200700200800200900200a00202800202900202f00205f003000"
"""Whitespace code points, six hex digits each."""


# -----------------------------------------------------------------------------
# Decoding
# -----------------------------------------------------------------------------


def _hex_value(digit: UInt8) -> Int:
    """Convert one ASCII hex digit to its value.

    Args:
        digit: An ASCII byte holding a lowercase hex digit.

    Returns:
        The value 0 through 15.

    The tables are generated by this project and contain only
    lowercase hex, so this does no validation. A malformed table is
    a bug in the generator, not user input.
    """
    # ASCII '0' is 48 and 'a' is 97.
    if digit <= 57:
        return Int(digit) - 48
    return Int(digit) - 97 + 10


def _decode_field(table: StaticString, index: Int, width: Int) -> Int:
    """Read one fixed width hex field out of an encoded table.

    Args:
        table: The encoded table.
        index: Which field to read, counting from zero.
        width: Number of hex digits per field.

    Returns:
        The decoded integer.
    """
    var bytes = table.as_bytes()
    var start = index * width
    var value = 0
    for offset in range(width):
        value = value * 16 + _hex_value(bytes[start + offset])
    return value


# -----------------------------------------------------------------------------
# Lookup
# -----------------------------------------------------------------------------


def class_of_code_point(code_point: Int) -> UInt8:
    """Return the Knap class of one code point.

    Args:
        code_point: The code point to classify.

    Returns:
        One of the CLASS_ constants.

    ASCII resolves through a direct table, which is the case that
    matters because real text is dominated by it. Everything else
    binary searches the sorted runs, and a code point in no run is
    OTHER.
    """
    if code_point < 0:
        return CLASS_OTHER
    if code_point < 128:
        # Direct index. One hex digit per ASCII code point.
        return UInt8(_hex_value(ASCII_CLASSES.as_bytes()[code_point]))

    var low = 0
    var high = RUN_COUNT - 1
    while low <= high:
        var middle = (low + high) // 2
        var start = _decode_field(RUN_STARTS, middle, 6)
        if code_point < start:
            high = middle - 1
            continue
        var end = _decode_field(RUN_ENDS, middle, 6)
        if code_point > end:
            low = middle + 1
            continue
        return UInt8(_decode_field(RUN_CLASSES, middle, 1))
    return CLASS_OTHER


def is_letter(code_point: Int) -> Bool:
    """Report whether a code point is in Unicode category L.

    Args:
        code_point: The code point to test.

    Returns:
        True for any of the five letter classes.
    """
    var value = class_of_code_point(code_point)
    return value >= CLASS_LU and value <= CLASS_LO


def is_number(code_point: Int) -> Bool:
    """Report whether a code point is in Unicode category N.

    Args:
        code_point: The code point to test.

    Returns:
        True for Nd, Nl, and No.
    """
    return class_of_code_point(code_point) == CLASS_N


def is_mark(code_point: Int) -> Bool:
    """Report whether a code point is in Unicode category M.

    Args:
        code_point: The code point to test.

    Returns:
        True for Mn, Mc, and Me.
    """
    return class_of_code_point(code_point) == CLASS_M


def is_whitespace(code_point: Int) -> Bool:
    """Report whether a code point is whitespace for these patterns.

    Args:
        code_point: The code point to test.

    Returns:
        True for the 25 code points the reference regex treats as
        whitespace.

    The set is small and enumerated, so this is a linear scan with
    an ASCII short circuit rather than a table lookup.
    """
    # The ASCII cases cover almost all real input.
    if code_point == 32:
        return True
    if code_point >= 9 and code_point <= 13:
        return True
    if code_point < 128:
        return False
    for index in range(WHITESPACE_COUNT):
        if _decode_field(WHITESPACE_CODE_POINTS, index, 6) == code_point:
            return True
    return False


# =============================================================================
# End of file: src/knap/pretokenize/unicode_tables.mojo
# =============================================================================
